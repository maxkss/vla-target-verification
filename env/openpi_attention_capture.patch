@@ -277,3 +277,51 @@ class Pi0(_model.BaseModel):
 
         x_0, _ = jax.lax.while_loop(cond, step, (noise, 1.0))
         return x_0
+
+    def denoise_prepare(self, observation: _model.Observation, noise: at.Float[at.Array, "b ah ad"]) -> dict:
+        """Inference only: preprocess the observation and fill the prefix KV cache as `sample_actions` does."""
+        observation = _model.preprocess_observation(None, observation, train=False)
+        prefix_tokens, prefix_mask, prefix_ar_mask = self.embed_prefix(observation)
+        positions = jnp.cumsum(prefix_mask, axis=1) - 1
+        _, kv_cache = self.PaliGemma.llm(
+            [prefix_tokens, None], mask=make_attn_mask(prefix_mask, prefix_ar_mask), positions=positions
+        )
+        return {
+            "observation": observation,
+            "prefix_mask": prefix_mask,
+            "kv_cache": kv_cache,
+            "x": noise,
+            "time": jnp.asarray(1.0, dtype=jnp.float32),
+        }
+
+    def denoise_step(self, state: dict, capture_indices: at.Int[at.Array, " k"] | None = None, *, num_steps: int = 10):
+        """One integration step of `sample_actions`.
+
+        With `capture_indices`, also returns the post-softmax attention of the action queries to those keys,
+        per layer: (layer, batch, head, query, key). The capture is read-only; the step itself is unchanged.
+        """
+        observation, x_t, time = state["observation"], state["x"], state["time"]
+        prefix_mask = state["prefix_mask"]
+        suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
+            observation, x_t, jnp.broadcast_to(time, x_t.shape[0])
+        )
+        full_attn_mask = jnp.concatenate(
+            [
+                einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1]),
+                make_attn_mask(suffix_mask, suffix_ar_mask),
+            ],
+            axis=-1,
+        )
+        positions = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+        result = self.PaliGemma.llm(
+            [None, suffix_tokens],
+            mask=full_attn_mask,
+            positions=positions,
+            kv_cache=state["kv_cache"],
+            adarms_cond=[None, adarms_cond],
+            capture_indices=capture_indices,
+        )
+        v_t = self.action_out_proj(result[0][1][:, -self.action_horizon :])
+        dt = -1.0 / num_steps
+        captured = result[2] if capture_indices is not None else None
+        return {**state, "x": x_t + dt * v_t, "time": time + dt}, captured
