# Machine-specific paths. Copy to env/local.sh (not tracked) and edit; run.sh sources it.
# env/setup.sh writes it for you with every path inside the repo: runs/, third_party/, envs/, models/.
export VTV_RUNS=/path/to/runs                       # run folders are created here
export OPENPI_ROOT=/path/to/openpi                  # openpi at the pinned commit with env/openpi_attention_capture.patch applied
export OPENPI_CHECKPOINT=/path/to/checkpoints/pi05_libero
export LIBERO_PARA_ROOT=/path/to/LIBERO-Para        # at the pinned commit
export HF_HOME=/path/to/huggingface                 # SAM 2.1 and Qwen3.5-9B at the pinned revisions
export POLICY_PYTHON=/path/to/policy-env/bin/python # JAX / openpi / LIBERO
export SAM_PYTHON=/path/to/sam-env/bin/python       # SAM 2.1
export VLM_PYTHON=/path/to/vlm-env/bin/python       # Qwen3.5-9B (transformers)
export GPUS="${GPUS:-0 1}"                          # GPUs to use (a value set by the caller wins)
